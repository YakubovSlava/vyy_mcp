{
  "name": "echo",
  "version": "1.0.0",
  "description": "Echoes the given text back, optionally shouting it.",
  "entrypoint": "tool:echo",
  "parameters": {
    "type": "object",
    "properties": {
      "text": { "type": "string", "description": "Text to echo back" },
      "shout": { "type": "boolean", "description": "Uppercase the result" }
    },
    "required": ["text"]
  }
}
